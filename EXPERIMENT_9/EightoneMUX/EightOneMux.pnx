<?xml version='1.0' encoding='utf-8' ?>
<!DOCTYPE ibis [
<!ELEMENT ibis (part, pin+)>
<!ELEMENT part EMPTY>
<!ELEMENT pin EMPTY>
<!ATTLIST part
  arch   CDATA #REQUIRED
  device CDATA #REQUIRED
  spg    CDATA #REQUIRED
  pkg    CDATA #REQUIRED>
<!ATTLIST pin
  nm     CDATA #REQUIRED
  no     CDATA #REQUIRED
  iostd  (TTL|LVTTL|LVCMOS2|NA) "NA"
  sr     (SLOW|FAST|slow|fast) "SLOW"
  dir    (BIDIR|bidir|INPUT|input|OUTPUT|output) "BIDIR">
]>
<ibis><part arch="xc9500xl" device="XC9572XL" pkg="TQ100" spg="-10"/><pin dir="input" nm="input_s7" no="40"/><pin dir="input" nm="input_SEL&lt;2&gt;" no="29"/><pin dir="input" nm="input_s3" no="50"/><pin dir="input" nm="input_s1" no="53"/><pin dir="input" nm="input_s2" no="52"/><pin dir="input" nm="input_s0" no="54"/><pin dir="input" nm="input_SEL&lt;1&gt;" no="30"/><pin dir="input" nm="input_SEL&lt;0&gt;" no="32"/><pin dir="input" nm="input_s5" no="42"/><pin dir="input" nm="input_s6" no="41"/><pin dir="input" nm="input_s4" no="49"/><pin dir="output" nm="output_s15" no="55" sr="fast"/></ibis>
