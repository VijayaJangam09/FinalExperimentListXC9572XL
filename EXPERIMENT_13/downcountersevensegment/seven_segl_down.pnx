<?xml version='1.0' encoding='utf-8' ?>
<!DOCTYPE ibis [
<!ELEMENT ibis (part, pin+)>
<!ELEMENT part EMPTY>
<!ELEMENT pin EMPTY>
<!ATTLIST part
  arch   CDATA #REQUIRED
  device CDATA #REQUIRED
  spg    CDATA #REQUIRED
  pkg    CDATA #REQUIRED>
<!ATTLIST pin
  nm     CDATA #REQUIRED
  no     CDATA #REQUIRED
  iostd  (TTL|LVTTL|LVCMOS2|NA) "NA"
  sr     (SLOW|FAST|slow|fast) "SLOW"
  dir    (BIDIR|bidir|INPUT|input|OUTPUT|output) "BIDIR">
]>
<ibis><part arch="xc9500xl" device="XC9572XL" pkg="TQ100" spg="-10"/><pin dir="input" nm="clk" no="22"/><pin dir="input" nm="rst" no="99"/><pin dir="output" nm="seg&lt;0&gt;" no="86" sr="fast"/><pin dir="output" nm="seg&lt;1&gt;" no="85" sr="fast"/><pin dir="output" nm="seg&lt;2&gt;" no="89" sr="fast"/><pin dir="output" nm="seg&lt;3&gt;" no="90" sr="fast"/><pin dir="output" nm="seg&lt;4&gt;" no="91" sr="fast"/><pin dir="output" nm="seg&lt;5&gt;" no="92" sr="fast"/><pin dir="output" nm="seg&lt;6&gt;" no="93" sr="fast"/><pin dir="output" nm="an&lt;0&gt;" no="94" sr="fast"/><pin dir="output" nm="an&lt;3&gt;" no="97" sr="fast"/><pin dir="output" nm="an&lt;2&gt;" no="96" sr="fast"/><pin dir="output" nm="an&lt;1&gt;" no="95" sr="fast"/></ibis>
